# 拼豆 API 本地开发环境变量（复制为 .env 后按需修改）
# 不要把真实密钥写进仓库。
HOST=0.0.0.0
PORT=3000

# PostgreSQL（与 docker-compose 一致）
DATABASE_URL=postgres://pindou:pindou_dev@127.0.0.1:5432/pindou


# JWT。生产环境请换成足够长的随机串。
JWT_SECRET=change-me-in-production-please-use-a-long-random-string

# 微信小程序。留空时登录走开发态：同一 code 映射到同一用户，不请求微信。
# 填上之后，POST /api/v1/auth/wx-login 会调用
# https://api.weixin.qq.com/sns/jscode2session
# 支付和登录必须是同一个小程序 AppID。也可以另设 WECHAT_APP_ID 覆盖。
WX_APPID=
WX_SECRET=

# 微信支付 API v3（JSAPI / 小程序 wx.requestPayment）。
# 下面商户参数全部留空：充值走开发示意，POST /credits/orders/{id}/mock-callback 幂等到账，不会请求微信。
# 只要填写了任意一项，示意到账立刻关闭；缺项时下单返回 503，不会加积分。
# 不要把真实私钥、APIv3 密钥写进仓库。
# WECHAT_APP_ID=                 # 可选，默认用上面的 WX_APPID
# WECHAT_MCH_ID=                 # 商户号
# WECHAT_MCH_SERIAL_NO=          # 商户 API 证书序列号
# 私钥二选一：PEM 文本（可用 \n 表示换行）或文件路径。
# WECHAT_MCH_PRIVATE_KEY=
# WECHAT_MCH_PRIVATE_KEY_PATH=./apiclient_key.pem
# WECHAT_PAY_API_V3_KEY=         # 32 位 APIv3 密钥
# 回调必须是微信服务器能访问的 https，且不能带查询参数。
# 留空时用 PUBLIC_BASE_URL/api/v1/pay/wechat/notify（本地 http 不能给真微信用）。
# WECHAT_PAY_NOTIFY_URL=https://example.com/api/v1/pay/wechat/notify
# 微信支付公钥（商户平台 API 安全里申请）和公钥 ID。推荐配置。
# 两者都留空时，服务会调用 /v3/certificates，用 APIv3 密钥解密并缓存平台证书。
# WECHAT_PAY_PUBLIC_KEY=
# WECHAT_PAY_PUBLIC_KEY_PATH=./wechatpay_pub.pem
# WECHAT_PAY_PUBLIC_KEY_ID=
# 仅测试：把预下单打到假微信。生产不要改。
# WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com

# 本地对象存储（COS 形状的占位：key / url / etag）
STORAGE_DIR=./data/objects
# 阿里云要能下载这张图。本地 127.0.0.1 阿里云访问不到，开发请留空密钥走模拟。
PUBLIC_BASE_URL=http://127.0.0.1:3000

# MVP+ 视觉管线。两个都留空时自动走开发模拟（透明 PNG + 卡通色阶 + 真实拼豆量化），不请求阿里云。
# 不要把真实密钥写进仓库。
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# 视觉智能区域，人体/通用分割和人物动漫化默认在上海。
ALIYUN_REGION=cn-shanghai
# auto：有密钥用阿里云，否则模拟。mock：强制模拟。aliyun：强制阿里云（缺密钥时出稿接口直接 400）。
PIPELINE_PROVIDER=auto
# 可选，覆盖主机名，不要带 https://
# ALIYUN_IMAGESEG_ENDPOINT=imageseg.cn-shanghai.aliyuncs.com
# ALIYUN_IMAGEENHAN_ENDPOINT=imageenhan.cn-shanghai.aliyuncs.com
