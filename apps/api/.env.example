# 拼豆 API 本地开发环境变量（复制为 .env 后按需修改）
# 不要把真实密钥写进仓库。
HOST=0.0.0.0
PORT=3000

# PostgreSQL（与 docker-compose 一致）
DATABASE_URL=postgres://pindou:pindou_dev@127.0.0.1:5432/pindou


# JWT。生产环境请换成足够长的随机串。
JWT_SECRET=change-me-in-production-please-use-a-long-random-string

# 微信小程序。留空时登录走开发态：同一 code 映射到同一用户，不请求微信。
# 填上之后，POST /api/v1/auth/wx-login 会调用
# https://api.weixin.qq.com/sns/jscode2session
# 支付和登录必须是同一个小程序 AppID。也可以另设 WECHAT_APP_ID 覆盖。
WX_APPID=
WX_SECRET=

# 微信支付 API v3（JSAPI / 小程序 wx.requestPayment）。
# 下面商户参数全部留空：充值走开发示意，POST /credits/orders/{id}/mock-callback 幂等到账，不会请求微信。
# 只要填写了任意一项，示意到账立刻关闭；缺项时下单返回 503，不会加积分。
# 不要把真实私钥、APIv3 密钥写进仓库。
# WECHAT_APP_ID=                 # 可选，默认用上面的 WX_APPID
# WECHAT_MCH_ID=                 # 商户号
# WECHAT_MCH_SERIAL_NO=          # 商户 API 证书序列号
# 私钥二选一：PEM 文本（可用 \n 表示换行）或文件路径。
# WECHAT_MCH_PRIVATE_KEY=
# WECHAT_MCH_PRIVATE_KEY_PATH=./apiclient_key.pem
# WECHAT_PAY_API_V3_KEY=         # 32 位 APIv3 密钥
# 回调必须是微信服务器能访问的 https，且不能带查询参数。
# 留空时用 PUBLIC_BASE_URL/api/v1/pay/wechat/notify（本地 http 不能给真微信用）。
# WECHAT_PAY_NOTIFY_URL=https://example.com/api/v1/pay/wechat/notify
# 微信支付公钥（商户平台 API 安全里申请）和公钥 ID。推荐配置。
# 两者都留空时，服务会调用 /v3/certificates，用 APIv3 密钥解密并缓存平台证书。
# WECHAT_PAY_PUBLIC_KEY=
# WECHAT_PAY_PUBLIC_KEY_PATH=./wechatpay_pub.pem
# WECHAT_PAY_PUBLIC_KEY_ID=
# 仅测试：把预下单打到假微信。生产不要改。
# WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com

# 小程序虚拟支付（米大师道具直购，wx.requestVirtualPayment）。
# 配齐后充值优先走这里，不再走上面的商户 JSAPI。全部留空则仍按商户参数或开发示意。
# 只要填写了任意一项，示意到账关闭；缺项时下单返回 503。
# 不要把 AppKey 写进仓库、文档或日志。
# WX_VIRTUAL_OFFER_ID=          # 支付应用 ID（OfferID），MP「虚拟支付 → 基本配置」
# 默认沙箱：不设 WX_VIRTUAL_ENV，或设为 1。signData.env=1，签名用沙箱 AppKey。
# 只配了现网 AppKey 时不会自动切到现网，必须同时 WX_VIRTUAL_ENV=0。
# WX_VIRTUAL_ENV=1
# WX_VIRTUAL_APPKEY_SANDBOX=
# 现网 AppKey 二选一，同时设置时必须相同。
# WX_VIRTUAL_APPKEY=
# WX_VIRTUAL_APPKEY_PROD=
# 道具 ID 默认就是档位 code：small / popular / large。价格必须与档位一致（600 / 1800 / 3000 分）。
# WX_VIRTUAL_PRODUCT_SMALL=small
# WX_VIRTUAL_PRODUCT_POPULAR=popular
# WX_VIRTUAL_PRODUCT_LARGE=large
# 消息推送 Token，与小程序「开发管理 → 消息推送」里的 Token 一致。
# 留空时发货推送无法验签，只能靠查单入账。请使用明文 JSON，不要选安全模式。
# WX_VIRTUAL_MSG_TOKEN=
# 发货通知地址是 PUBLIC_BASE_URL/api/v1/pay/virtual/notify ，在 MP 后台填写，不由下单请求上传。
# 仅测试：把查单打到假微信。生产不要改。
# WX_VIRTUAL_API_BASE=https://api.weixin.qq.com

# 客诉退款口令。留空时 POST /api/v1/ops/credit-orders/{id}/refund 返回 503。
# 只给运营 curl 使用，不要配进小程序，不要写进仓库。请求头：X-Ops-Token。
# OPS_REFUND_TOKEN=

# 本地对象存储（COS 形状的占位：key / url / etag）
STORAGE_DIR=./data/objects
# 预览图、头像等文件 URL 的前缀。Seedream 图生图把原图内联成 data URL，不让方舟回源这个地址。
PUBLIC_BASE_URL=http://127.0.0.1:3000

# MVP+ 出稿：火山方舟 Seedream 5.0 Flash 图生图，再由本服务最近邻做成 52/78/104 珠图。
# ARK_API_KEY 留空且 PIPELINE_PROVIDER=auto 时走开发模拟（透明平涂 PNG + 真实拼豆量化），不请求网络。
# 这是方舟 API Key，不是阿里云 AccessKey，也不是视觉智能 / VIAPI 密钥。不要把真实密钥写进仓库。
# ARK_API_KEY=
# 可选。默认 https://ark.cn-beijing.volces.com ，模型 doubao-seedream-5-0-flash-260915。
# ARK_BASE_URL=https://ark.cn-beijing.volces.com
# ARK_MODEL=doubao-seedream-5-0-flash-260915
# auto：有 ARK_API_KEY 用 Seedream，否则模拟。
# mock：强制模拟。seedream / ark：强制方舟（缺密钥时出稿接口直接 400）。
# 不要设 aliyun。视觉智能已不在出稿路径。
PIPELINE_PROVIDER=auto
